PARLIAMENT_DB_PASSWORD=replace-with-a-long-random-local-password
PARLIAMENT_DB_ROOT_PASSWORD=replace-with-another-long-random-local-password
PARLIAMENT_INGESTION_API_KEY=your-open-assembly-api-key
# Optional explicit law collector; never put OC in a browser bundle or source URL.
PARLIAMENT_LAW_OC=
PARLIAMENT_LAW_CA_CERTIFICATE=
PARLIAMENT_INGESTION_ADMIN_KEY=replace-with-a-long-random-admin-key

# Keep false while running only preflight.
PARLIAMENT_INGESTION_ENABLED=true
PARLIAMENT_INGESTION_WRITE_ENABLED=false

# Optional scheduled incremental sync. Keep disabled until the first load is complete.
PARLIAMENT_AUTOMATIC_SYNC_ENABLED=false
PARLIAMENT_INCREMENTAL_CRON="0 0 */6 * * *"
PARLIAMENT_INCREMENTAL_ZONE=Asia/Seoul

# Optional local PEM for HTTPS inspection/proxy environments. Never commit the PEM.
PARLIAMENT_OPEN_ASSEMBLY_CA_CERTIFICATE=

# Public service can run without enabling national API ingestion.
TRACKING_ENABLED=true
# Enable only after additive 013/014/015 migrations and source/role review.
KNOWLEDGE_ENABLED=false
TRACKING_ADMIN_KEY=replace-with-a-different-long-random-admin-key
TRACKING_PUBLIC_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# After source contract verification, start a bounded set rather than all 269 APIs.
PARLIAMENT_INCREMENTAL_SOURCE_KEYS=billrcp,billinfodetail,nojepdqqaweusdfbi,billjudgeconf,billlwjudgeconf
PARLIAMENT_DAILY_SOURCE_KEYS=allnamember
PARLIAMENT_RECONCILIATION_ENABLED=false

# Optional explicit model drafts; token rates must include your actual model billing basis.
# All sources share one persistent ledger. Collection never invokes a paid model by default.
PARLIAMENT_REVIEW_LEDGER=/data/review.sqlite3
PARLIAMENT_SUMMARY_MONTHLY_BUDGET_KRW=100000
PARLIAMENT_SUMMARY_MODEL=
PARLIAMENT_SUMMARY_INPUT_KRW_PER_MILLION=
PARLIAMENT_SUMMARY_OUTPUT_KRW_PER_MILLION=
OPENAI_API_KEY=

# Verified SES sender and explicit operation are required for actual delivery.
PARLIAMENT_MAIL_FROM=
PARLIAMENT_MAIL_DELIVERY_ENABLED=false

# GraphRAG is private and opt-in. Use the provider's single inference key.
# Put real values in an ignored 0600 file or secret manager, never in this file.
QWEN_BASE_URL=
QWEN_INFERENCE_TOKEN=
GRAPHRAG_MODEL_REPO=
GRAPHRAG_MODEL_REVISION=
GRAPHRAG_API_TOKEN=

# Opt-in, consented beta study (maximum 35 days); apply additive migration 017 first.
# BETA_ENABLED controls public admissions; schema-aware retention cleanup remains active when false.
BETA_ENABLED=false
EDITORIAL_PREVIEW_ENABLED=false
BETA_PUBLIC_BASE_URL=http://localhost:3000
BETA_ADMIN_KEY=replace-with-a-different-long-random-beta-admin-key
